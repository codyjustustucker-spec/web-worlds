{
  "name": "web-worlds",
  "version": "0.27.0",
  "private": true,
  "description": "Interactive browser playground and engineering showcase built with static HTML, CSS, and vanilla JavaScript.",
  "scripts": {
    "serve": "node scripts/static-server.mjs 4173",
    "lint": "eslint .",
    "lint:syntax": "node scripts/check-syntax.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:links": "node scripts/check-links.mjs",
    "test:production": "node scripts/check-production.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:critical": "playwright test tests/e2e --project=chromium --project=mobile-chromium",
    "test:e2e:cross": "playwright test tests/e2e/smoke.spec.mjs --project=firefox --project=webkit",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs",
    "quality:report": "node scripts/generate-quality-report.mjs",
    "quality:static": "npm run lint:syntax && npm test && npm run test:links && npm run test:html && npm run quality:report",
    "quality": "npm run lint && npm run lint:syntax && npm test && npm run test:links && npm run test:html && npm run test:e2e:critical && npm run test:a11y",
    "quality:full": "npm run quality && npm run test:e2e:cross && npm run audit:lighthouse",
    "test:api": "node --test tests/backend/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "worker:dev": "wrangler dev",
    "worker:migrate:local": "wrangler d1 migrations apply web-worlds-scores --local",
    "worker:migrate:remote": "wrangler d1 migrations apply web-worlds-scores --remote",
    "worker:deploy": "wrangler deploy",
    "test:html": "node scripts/check-html.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "chrome-launcher": "^1.0.0",
    "eslint": "^10.10.0",
    "lighthouse": "^12.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
